-- Crear estas medidas en la tabla fact_subscriptions.

Total Clientes = DISTINCTCOUNT(fact_subscriptions[customer_id])

Clientes Activos =
CALCULATE(
    [Total Clientes],
    fact_subscriptions[status] = "Active"
)

Clientes Churned =
CALCULATE(
    [Total Clientes],
    fact_subscriptions[status] = "Churned"
)

Tasa de Churn = DIVIDE([Clientes Churned], [Total Clientes], 0)

MRR Activo =
CALCULATE(
    SUM(fact_subscriptions[monthly_revenue]),
    fact_subscriptions[status] = "Active"
)

MRR Perdido =
CALCULATE(
    SUM(fact_subscriptions[monthly_revenue]),
    fact_subscriptions[status] = "Churned"
)

Antigüedad Promedio (Meses) =
AVERAGEX(
    VALUES(dim_customers[customer_id]),
    DATEDIFF(MAX(dim_customers[signup_date]), TODAY(), MONTH)
)

Tickets por Cliente =
DIVIDE(
    COUNTROWS(fact_support_tickets),
    DISTINCTCOUNT(dim_customers[customer_id]),
    0
)

Satisfacción Promedio = AVERAGE(fact_support_tickets[satisfaction_score])

Clientes Riesgo Alto =
COUNTROWS(
    FILTER(
        VALUES(dim_customers[customer_id]),
        CALCULATE(COUNTROWS(fact_support_tickets)) >= 3
            && CALCULATE(AVERAGE(fact_support_tickets[satisfaction_score])) <= 2.5
            && CALCULATE(MAX(fact_subscriptions[status])) = "Active"
    )
)
